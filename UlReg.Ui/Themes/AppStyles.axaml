<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20">
      <!-- Add Controls for Previewer Here -->
    </Border>
  </Design.PreviewWith>

  <!-- Add Styles Here -->
  <Style Selector="Label">
    <Setter Property="Padding" Value="0 3 3 3"></Setter>
  </Style>
  <Style Selector="TreeDataGrid > Border">
    <Setter Property="Padding" Value="3 0 3 0" />
  </Style>
  <Style Selector="TextBox TextPresenter#PART_TextPresenter">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=".status-bar TextElement">
    <Setter Property="Foreground" Value="#737575" />
  </Style>

  <Style Selector="TreeDataGrid">
    <Setter Property="Background" Value="{DynamicResource TableRow_Background-Primary}" />
  </Style>
  <Style Selector="TreeDataGridRow">
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="TreeDataGridColumnHeader,TreeDataGridRow">
    <Setter Property="Foreground" Value="{DynamicResource TableRow_Foreground}" />
  </Style>
  <Style Selector="TreeDataGridRow:nth-child(even)">
    <Setter Property="Background" Value="{DynamicResource TableRow_Background-Secondary}" />
  </Style>
  <Style Selector="TreeDataGridColumnHeader:nth-child(4), TreeDataGridRow  TreeDataGridTextCell:nth-child(4)">
    <Setter Property="TextElement.Foreground" Value="#837f80" />
    <Setter Property="TextElement.FontFamily" Value="Menlo" />
  </Style>

  <Style Selector="StackPanel.status-bar">
    <Setter Property="Background" Value="{DynamicResource StatusBar_Background}" />
  </Style>

</Styles>
