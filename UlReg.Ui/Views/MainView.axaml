<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UlReg.ViewModels;assembly=UlReg.Core"
             xmlns:views="clr-namespace:UlReg.Views"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="740"
             x:Class="UlReg.Views.MainView"
             x:CompileBindings="True" x:DataType="views:Shim">
  <DockPanel>

    <Grid DockPanel.Dock="Top"
          Margin="9 0 9 12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Width="auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <Label Content="Term" />
        <TextBox Name="InputSearchTerm" Text="{Binding SearchTerm.Value}"/>
      </StackPanel>

      <StackPanel Grid.Column="1" Margin="9 0 0 0">
        <Label Content="Octet" />
        <TextBox
          MaxLength="8"
          MinWidth="92"
          Text="{Binding SearchUl0.Value}" />
      </StackPanel>

      <StackPanel Grid.Column="2" Margin="3 0 0 0">
        <Label Content="" />
        <TextBox
          MaxLength="8"
          MinWidth="92"
          Text="{Binding SearchUl4.Value}" />
      </StackPanel>

      <StackPanel Grid.Column="3" Margin="3 0 0 0">
        <Label Content="" />
        <TextBox
          MaxLength="8"
          MinWidth="92"
          Text="{Binding SearchUl8.Value}" />
      </StackPanel>

      <StackPanel Grid.Column="4" Margin="3 0 0 0">
        <Label Content="" />
        <TextBox
          MaxLength="8"
          MinWidth="92"
          Text="{Binding SearchUl12.Value}" />
      </StackPanel>

    </Grid>

    <Rectangle HorizontalAlignment="Stretch"
               Height="0.5"
               Fill="{DynamicResource TitleBarSeparatorColorTop}"
               Margin="0 0 0 0"
               DockPanel.Dock="Top" />
    <Rectangle HorizontalAlignment="Stretch"
               Height="0.5"
               Fill="{DynamicResource TitleBarSeparatorColorBottom}"
               Margin="0 0 0 0"
               DockPanel.Dock="Top" />

    <StackPanel Orientation="Horizontal"
                Classes="status-bar"
                DockPanel.Dock="Bottom">
      <TextBlock HorizontalAlignment="Left" Padding="6">
        <Run Text="Total:" />
        <Run Text="{Binding EntriesView.Count}" />
      </TextBlock>
      <TextBlock Padding="6">
        <Run Text="Selected:" />
        <Run Text="{Binding SelectedRowsCount.Value, Mode=OneWay}"/>
      </TextBlock>
    </StackPanel>

    <Rectangle HorizontalAlignment="Stretch"
               Height="0.5"
               Margin="0 0 0 0"
               Fill="{DynamicResource StatusBarSeparatorColorBottom}"
               DockPanel.Dock="Bottom" />
    <!-- bottom ⬆️  -->
    <!-- because dock priority, the stack of down docked items -->
    <!-- the first one is the most down -->
    <!-- ⬇️ top -->
    <Rectangle HorizontalAlignment="Stretch"
               Height="0.5"
               Margin="0 0 0 0"
               Fill="{DynamicResource StatusBarSeparatorColorTop}"
               DockPanel.Dock="Bottom" />

    <TreeDataGrid
      Margin="0 0 0 0"
      Padding="0 0 0 0"
      Source="{Binding Source.Value}"
      Name="MyTreeDataGrid">
    </TreeDataGrid>

  </DockPanel>
</UserControl>
