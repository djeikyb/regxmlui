<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:UlReg.ViewModels;assembly=UlReg.Core"
        xmlns:views="clr-namespace:UlReg.Views"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="740"
        x:Class="UlReg.Views.MainWindow"
        Title="Universal Labels"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        SystemDecorations="Full"
        Position="50,0"
        Width="750"
        Height="740"
        WindowState="Normal"
        WindowStartupLocation="Manual"
        Topmost="{Binding Topmost.Value}"
        FontFamily="SF Pro"
        FontSize="12"
        Background="{DynamicResource AcrylicColor}"
        x:Name="Main"
        x:CompileBindings="True" x:DataType="views:Shim">
  <Panel>
    <ExperimentalAcrylicBorder Name="AcrylicBorder"
                               IsHitTestVisible="False"
                               IsVisible="True">
      <ExperimentalAcrylicBorder.Material>
        <ExperimentalAcrylicMaterial BackgroundSource="None"
                                     TintColor="{DynamicResource AcrylicColor}"
                                     FallbackColor="{DynamicResource AcrylicColor}"
                                     TintOpacity="{Binding TintOpacity.Value}"
                                     MaterialOpacity="{Binding MaterialOpacity.Value}" />
      </ExperimentalAcrylicBorder.Material>
    </ExperimentalAcrylicBorder>
    <Panel Margin="{Binding #Main.OffScreenMargin}">
      <Panel Margin="{Binding #Main.WindowDecorationMargin}">
        <views:MainView />
      </Panel>
    </Panel>
  </Panel>
</Window>
